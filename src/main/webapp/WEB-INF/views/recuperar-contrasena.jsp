<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recuperar contraseña | JobMentor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/login.css?v=2"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/ofertas.css?v=15"></head><body><main class="login-page recuperacion-page"><section class="login-card recuperacion-card"><img class="recuperacion-logo" src="${pageContext.request.contextPath}/img/logo.png" alt="JobMentor"><h1>Recuperar contraseña</h1><p style="color:#617895;margin:12px 0 24px">Ingresá tu correo y te enviaremos un enlace válido durante 10 minutos.</p><% if (request.getAttribute("enviado") != null) { %><div class="mensaje-exito">Si el correo está registrado, recibirás las instrucciones en unos instantes.</div><% } %><form method="post" class="login-form" action="${pageContext.request.contextPath}/recuperar-contrasena"><div class="login-field"><label for="correo">Correo electrónico</label><input type="email" id="correo" name="correo" required></div><button class="login-button" type="submit">Enviar enlace</button></form><a class="btn-recuperacion-secundario" href="${pageContext.request.contextPath}/ofertas">Volver a JobMentor</a></section></main></body></html>
