<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cambiar contraseña | JobMentor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/login.css?v=2"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/ofertas.css?v=15"></head><body><main class="login-page recuperacion-page"><section class="login-card recuperacion-card"><img class="recuperacion-logo" src="${pageContext.request.contextPath}/img/logo.png" alt="JobMentor"><h1>Cambiar contraseña</h1><% if (request.getAttribute("exito") != null) { %><div class="mensaje-exito">Contraseña actualizada. Ya podés iniciar sesión.</div><a class="btn-primary" href="${pageContext.request.contextPath}/login">Iniciar sesión</a><% } else if (Boolean.FALSE.equals(request.getAttribute("valido"))) { %><div class="login-error">El enlace es inválido o venció.</div><a class="btn-primary" href="${pageContext.request.contextPath}/recuperar-contrasena">Solicitar otro enlace</a><% } else { %><p style="color:#617895">El enlace es válido durante 10 minutos.</p><% if (request.getAttribute("error") != null) { %><div class="login-error"><%= request.getAttribute("error") %></div><% } %><form method="post" class="login-form" action="${pageContext.request.contextPath}/restablecer-contrasena"><input type="hidden" name="token" value="${token}"><div class="login-field"><label>Nueva contraseña</label><input type="password" name="password" minlength="6" required></div><div class="login-field"><label>Repetir contraseña</label><input type="password" name="confirmacion" minlength="6" required></div><button class="login-button" type="submit">Guardar contraseña</button></form><% } %></section></main></body></html>
